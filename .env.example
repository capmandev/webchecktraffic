# Supabase PostgreSQL configuration
# Find these in Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Scarpa Traffic API Configuration
# Provided by owner (Keep secure on server-side!)
SCARPA_API_KEY=your-scarpa-api-key
SCARPA_API_ENDPOINT=https://api.scarpa.example/traffic

# Optional: Set to false to disable mock data generation when API key is missing
ENABLE_MOCK_FALLBACK=true

# Password for internal access (Mật khẩu truy cập nội bộ)
SITE_PASSWORD=traffic123

